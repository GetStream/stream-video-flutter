import '../../Fastfile'

default_platform(:mac)

before_all do
  setup_ci if is_ci
end

platform :mac do
  bundle_id = 'io.getstream.video.flutter.dogfooding'

  lane :build do |options|
    # Reuse parent fastfile tasks
    fetch_dependencies
    build_autogenerated_code

    build_number = options[:build_number] ? "--build-number #{options[:build_number]}" : ''

    sh_on_root(command: "flutter build macos --flavor #{options[:flavor]} --no-pub --suppress-analytics --release --config-only #{build_number}")
  end

  lane :archive do |options|
    configuration = "Release-#{options[:flavor]}"
    profile_name = ENV.fetch("sigh_#{bundle_id}_appstore_macos_profile-name")

    # The project signs automatically for local builds; CI signs manually with the match profile.
    update_code_signing_settings(
      path: 'Runner.xcodeproj',
      targets: ['Runner'],
      build_configurations: [configuration],
      use_automatic_signing: false,
      team_id: 'EHV7XZLAHA',
      code_sign_identity: ENV.fetch("sigh_#{bundle_id}_appstore_macos_certificate-name"),
      profile_name: profile_name,
    )

    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: options[:flavor],
      configuration: configuration,
      export_method: 'app-store',
      export_options: {
        provisioningProfiles: { bundle_id => profile_name },
      },
      silent: true,
      clean: true,
      output_directory: './dist',
    )
  end

  lane :build_and_deploy do |options|
    match(
      api_key: appstore_api_key,
      type: 'appstore',
      platform: 'macos',
      additional_cert_types: ['mac_installer_distribution'],
      app_identifier: [bundle_id],
      readonly: is_ci,
      force_for_new_devices: false,
    )

    current_build_number = app_store_build_number(
      api_key: appstore_api_key,
      live: false,
      app_identifier: bundle_id,
      username: ENV['FASTLANE_APPLE_ID'],
      team_id: 'EHV7XZLAHA',
      platform: 'osx',
    )

    build(
      flavor: options[:flavor],
      build_number: current_build_number + 1,
    )
    archive(flavor: options[:flavor])

    upload_to_testflight(
      api_key: appstore_api_key,
      app_platform: 'osx',
      pkg: lane_context[SharedValues::PKG_OUTPUT_PATH],
      distribute_external: false,
      groups: ['Internal Testers'],
      changelog: 'Lots of amazing new features to test out!',
      skip_waiting_for_build_processing: true,
      # A build that fails processing never appears, so stop waiting for it.
      wait_processing_timeout_duration: 900,
    )
  end

  private_lane :appstore_api_key do
    @appstore_api_key ||= app_store_connect_api_key(
      key_id: 'MT3PRT8TB7',
      issuer_id: '69a6de96-0738-47e3-e053-5b8c7c11a4d1',
      key_content: ENV.fetch('APPSTORE_API_KEY', nil),
      in_house: false
    )
  end

  desc "If `readonly: true` (by default), installs the Mac App Store certificates and profile.\nIf `readonly: false`, recreates them, updates them locally and remotely."
  lane :match_me do |options|
    match(
      api_key: appstore_api_key,
      type: 'appstore',
      platform: 'macos',
      additional_cert_types: ['mac_installer_distribution'],
      app_identifier: [bundle_id],
      readonly: options[:readonly],
    )
  end
end
